# Anthropic API Configuration (for Claude-powered smart updates)
ANTHROPIC_API_KEY=your-key-here

# OpenAI API Configuration (for web context scraping)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Postmark Email Configuration
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM_ADDRESS=frie@qollabi.com
POC_TEST_EMAIL=frie@qollabi.com

# Legacy SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@ale.com
SMTP_USE_TLS=true

# FTP Configuration (for PDF delivery)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PATH=/updates

# Webhook Configuration (for external integrations)
WEBHOOK_URL=

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
DATABASE_PATH=./data/qollabi.db

# API Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PDF Output Directory
PDF_OUTPUT_DIR=./outputs
